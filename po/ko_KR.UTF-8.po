msgid "Change Terminal Title"
msgstr "터미널 제목 변경"

msgid "Leave blank to restore the default title."
msgstr "제목란을 비워 두면 기본값으로 복원됩니다."

msgid "Cancel"
msgstr "취소"

msgid "OK"
msgstr "확인"

msgid "Configuration Errors"
msgstr "설정 오류"

msgid ""
"One or more configuration errors were found. Please review the errors below, "
"and either reload your configuration or ignore these errors."
msgstr ""
"설정에 하나 이상의 문제가 발견되었습니다. 아래 오류를 확인한 후 설정을 "
"다시 불러오거나 무시하세요."

msgid "Ignore"
msgstr "무시"

msgid "Reload Configuration"
msgstr "설정 값 다시 불러오기"

msgid "Split Up"
msgstr "위로 창 나누기"

msgid "Split Down"
msgstr "아래로 창 나누기"

msgid "Split Left"
msgstr "왼쪽으로 창 나누기"

msgid "Split Right"
msgstr "오른쪽으로 창 나누기"

msgid "Execute a command…"
msgstr "명령을 실행하세요…"

msgid "Copy"
msgstr "복사"

msgid "Paste"
msgstr "붙여넣기"

msgid "Clear"
msgstr "지우기"

msgid "Reset"
msgstr "초기화"

msgid "Split"
msgstr "나누기"

msgid "Change Title…"
msgstr "제목 변경…"

msgid "Tab"
msgstr "탭"

msgid "New Tab"
msgstr "새 탭"

msgid "Close Tab"
msgstr "탭 닫기"

msgid "Window"
msgstr "창"

msgid "New Window"
msgstr "새 창"

msgid "Close Window"
msgstr "창 닫기"

msgid "Config"
msgstr "설정"

msgid "Open Configuration"
msgstr "설정 열기"

msgid "Command Palette"
msgstr "명령 팔레트"

msgid "Terminal Inspector"
msgstr "터미널 인스펙터"

msgid "About Witty"
msgstr "Witty 정보"

msgid "Quit"
msgstr "종료"

msgid "Authorize Clipboard Access"
msgstr "클립보드 액세스 권한 부여"

msgid ""
"An application is attempting to read from the clipboard. The current "
"clipboard contents are shown below."
msgstr ""
"응용 프로그램이 클립보드에서 읽기를 시도하고 있습니다. 현재 클립보드 내용은 "
"아래와 같습니다."

msgid "Deny"
msgstr "거부"

msgid "Allow"
msgstr "허용"

msgid "Remember choice for this split"
msgstr "이 분할에 대한 선택 기억하기"

msgid "Reload configuration to show this prompt again"
msgstr "이 창을 다시 보려면 설정을 다시 불러오세요"

msgid ""
"An application is attempting to write to the clipboard. The current "
"clipboard contents are shown below."
msgstr ""
"응용 프로그램이 클립보드에 쓰기를 시도하고 있습니다. 현재 클립보드 내용은 아"
"래와 같습니다."

msgid "Warning: Potentially Unsafe Paste"
msgstr "경고: 잠재적으로 안전하지 않은 붙여넣기"

msgid ""
"Pasting this text into the terminal may be dangerous as it looks like some "
"commands may be executed."
msgstr "이 텍스트를 터미널에 붙여넣으면 일부 명령이 실행될 수 있어 위험할 수 있습니다."

msgid "Close"
msgstr "닫기"

msgid "Quit Witty?"
msgstr "Ghostty를 종료하시겠습니까?"

msgid "Close Window?"
msgstr "창을 닫으시겠습니까?"

msgid "Close Tab?"
msgstr "탭을 닫으시겠습니까?"

msgid "Close Split?"
msgstr "분할을 닫으시겠습니까?"

msgid "All terminal sessions will be terminated."
msgstr "모든 터미널 세션이 종료됩니다."

msgid "All terminal sessions in this window will be terminated."
msgstr "이 창의 모든 터미널 세션이 종료됩니다."

msgid "All terminal sessions in this tab will be terminated."
msgstr "이 탭의 모든 터미널 세션이 종료됩니다."

msgid "The currently running process in this split will be terminated."
msgstr "이 분할에서 현재 실행 중인 프로세스가 종료됩니다."

msgid "Copied to clipboard"
msgstr "클립보드에 복사됨"

msgid "Cleared clipboard"
msgstr "클립보드 지워짐"

msgid "Command Succeeded"
msgstr "명령 성공"

msgid "Command Failed"
msgstr "명령 실패"

msgid "Main Menu"
msgstr "메인 메뉴"

msgid "View Open Tabs"
msgstr "열린 탭 보기"

msgid "New Split"
msgstr "새 분할"

msgid ""
"⚠️ You're running a debug build of Witty! Performance will be degraded."
msgstr "⚠️ Witty 디버그 빌드로 실행 중입니다! 성능이 저하됩니다."

msgid "Reloaded the configuration"
msgstr "설정값을 다시 불러왔습니다"

msgid "Witty Developers"
msgstr "Witty 개발자들"

msgid "Witty: Terminal Inspector"
msgstr "Witty: 터미널 인스펙터"
