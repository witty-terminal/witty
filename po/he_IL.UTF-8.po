msgid "Change Terminal Title"
msgstr "שינוי כותרת המסוף"

msgid "Leave blank to restore the default title."
msgstr "השאר/י ריק כדי לשחזר את כותרת ברירת המחדל."

msgid "Cancel"
msgstr "ביטול"

msgid "OK"
msgstr "אישור"

msgid "Configuration Errors"
msgstr "שגיאות בהגדרות"

msgid ""
"One or more configuration errors were found. Please review the errors below, "
"and either reload your configuration or ignore these errors."
msgstr ""
"נמצאו אחת או יותר שגיאות בהגדרות. אנא בדוק/י את השגיאות המופיעות מטה ולאחר "
"מכן טען/י את ההגדרות מחדש או התעלם/י מהשגיאות."

msgid "Ignore"
msgstr "התעלמות"

msgid "Reload Configuration"
msgstr "טעינה מחדש של ההגדרות"

msgid "Split Up"
msgstr "פיצול למעלה"

msgid "Split Down"
msgstr "פיצול למטה"

msgid "Split Left"
msgstr "פיצול שמאלה"

msgid "Split Right"
msgstr "פיצול ימינה"

msgid "Execute a command…"
msgstr "הרץ/י פקודה…"

msgid "Copy"
msgstr "העתקה"

msgid "Paste"
msgstr "הדבקה"

msgid "Clear"
msgstr "ניקוי"

msgid "Reset"
msgstr "איפוס"

msgid "Split"
msgstr "פיצול"

msgid "Change Title…"
msgstr "שינוי כותרת…"

msgid "Tab"
msgstr "כרטיסייה"

msgid "New Tab"
msgstr "כרטיסייה חדשה"

msgid "Close Tab"
msgstr "סגור/י כרטיסייה"

msgid "Window"
msgstr "חלון"

msgid "New Window"
msgstr "חלון חדש"

msgid "Close Window"
msgstr "סגור/י חלון"

msgid "Config"
msgstr "הגדרות"

msgid "Open Configuration"
msgstr "פתיחת ההגדרות"

msgid "Command Palette"
msgstr "לוח פקודות"

msgid "Terminal Inspector"
msgstr "בודק המסוף"

msgid "About Witty"
msgstr "אודות Witty"

msgid "Quit"
msgstr "יציאה"

msgid "Authorize Clipboard Access"
msgstr "אשר/י גישה ללוח ההעתקה"

msgid ""
"An application is attempting to read from the clipboard. The current "
"clipboard contents are shown below."
msgstr "יש אפליקציה שמנסה לקרוא מלוח ההעתקה. התוכן הנוכחי של הלוח מופיע למטה."

msgid "Deny"
msgstr "דחייה"

msgid "Allow"
msgstr "אישור"

msgid "Remember choice for this split"
msgstr "זכור/י את הבחירה עבור פיצול זה"

msgid "Reload configuration to show this prompt again"
msgstr "טען/י את ההגדרות מחדש כדי להציג את הבקשה הזו שוב"

msgid ""
"An application is attempting to write to the clipboard. The current "
"clipboard contents are shown below."
msgstr ""
"יש אפליקציה שמנסה לכתוב לתוך לוח ההעתקה. התוכן הנוכחי של הלוח מופיע למטה."

msgid "Warning: Potentially Unsafe Paste"
msgstr "אזהרה: ההדבקה עלולה להיות מסוכנת"

msgid ""
"Pasting this text into the terminal may be dangerous as it looks like some "
"commands may be executed."
msgstr ""
"הדבקת טקסט זה במסוף עלולה להיות מסוכנת, מכיוון שככל הנראה היא תוביל להרצה של "
"פקודות מסוימות."

msgid "Close"
msgstr "סגירה"

msgid "Quit Witty?"
msgstr "לצאת מGhostty?"

msgid "Close Window?"
msgstr "לסגור את החלון?"

msgid "Close Tab?"
msgstr "לסגור את הכרטיסייה?"

msgid "Close Split?"
msgstr "לסגור את הפיצול?"

msgid "All terminal sessions will be terminated."
msgstr "כל הפעלות המסוף יסתיימו."

msgid "All terminal sessions in this window will be terminated."
msgstr "כל הפעלות המסוף בחלון זה יסתיימו."

msgid "All terminal sessions in this tab will be terminated."
msgstr "כל הפעלות המסוף בכרטיסייה זו יסתיימו."

msgid "The currently running process in this split will be terminated."
msgstr "התהליך שרץ כרגע בפיצול זה יסתיים."

msgid "Copied to clipboard"
msgstr "הועתק ללוח ההעתקה"

msgid "Cleared clipboard"
msgstr "לוח ההעתקה רוקן"

msgid "Command Succeeded"
msgstr "הפקודה הצליחה"

msgid "Command Failed"
msgstr "הפקודה נכשלה"

msgid "Main Menu"
msgstr "תפריט ראשי"

msgid "View Open Tabs"
msgstr "הצג/י כרטיסיות פתוחות"

msgid "New Split"
msgstr "פיצול חדש"

msgid ""
"⚠️ You're running a debug build of Witty! Performance will be degraded."
msgstr "⚠️ את/ה מריץ/ה גרסת ניפוי שגיאות של Witty! הביצועים יהיו ירודים."

msgid "Reloaded the configuration"
msgstr "ההגדרות הוטענו מחדש"

msgid "Witty Developers"
msgstr "המפתחים של Witty"

msgid "Witty: Terminal Inspector"
msgstr "Witty: בודק המסוף"
