+// Keep only as much streaming storage as the largest recording seen so far.
+fn (mut st State) ensure_vertex_buffer() bool {
+	if st.vbuf_capacity >= st.vertex_count {
+		return true
+	}
+	mut capacity := if st.vbuf_capacity > 0 { st.vbuf_capacity } else { 1024 }
+	for capacity < st.vertex_count && capacity <= st.max_vertices / 2 {
+		capacity *= 2
+	}
+	if capacity < st.vertex_count || capacity > st.max_vertices {
+		capacity = st.max_vertices
+	}
+	desc := gfx.BufferDesc{
+		size:  uint(capacity) * uint(sizeof(Vertex))
+		type:  .vertexbuffer
+		usage: .stream
+	}
+	buffer := gfx.make_buffer(&desc)
+	if gfx.query_buffer_state(buffer) != .valid {
+		if buffer.id != 0 {
+			gfx.destroy_buffer(buffer)
+		}
+		return false
+	}
+	if st.vbuf.id != 0 {
+		gfx.destroy_buffer(st.vbuf)
+	}
+	st.vbuf = buffer
+	st.vbuf_capacity = capacity
+	return true
+}
