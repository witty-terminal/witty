+	image_id   u32
@@ -53,0 +54,15 @@ pub fn set_gl_surface_texture(id string, gl_texture u32, width int, height int)
+	surface_texture_updated()
+}
+
+// set_surface_image supplies an application-owned Sokol image. Its top row is
+// the top of the surface. The producer must keep it alive through the UI pass.
+pub fn set_surface_image(id string, image_id u32, width int, height int) {
+	g_gl_surface_requests[id] = GlTextureRequest{
+		image_id: image_id
+		width: width
+		height: height
+	}
+	surface_texture_updated()
+}
