+_SOKOL_PRIVATE id<MTLBuffer> _sg_mtl_alloc_uniform_buffer(int frame) {
+    id<MTLBuffer> buffer = [_sg.mtl.device
+        newBufferWithLength:(NSUInteger)_sg.mtl.ub_size
+        options:MTLResourceCPUCacheModeWriteCombined|MTLResourceStorageModeShared
+    ];
+    #if defined(SOKOL_DEBUG)
+        buffer.label = [NSString stringWithFormat:@"sg-uniform-buffer.%d", frame];
+    #endif
+    _sg.mtl.uniform_buffers[frame] = buffer;
+    return buffer;
+}
